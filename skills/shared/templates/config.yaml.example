# Auto-Video Configuration
# This file is the single source of truth for all auto-video skills.
# Generated by auto-video-setup — do NOT edit manually unless you know what you're doing.

media:
  mode: api  # api | local | generated | hybrid
  providers:
    - name: pexels
      api_key: null
    - name: duckduckgo
  local_path: null
  generation:
    mode: null  # local | api
    model: null
    api_key: null
    model_path: null

tts:
  mode: api  # api | local | manual
  provider: openai  # elevenlabs | openai | kokoro | piper
  voice: alloy
  api_key: null
  model_path: null
  language: fr

remotion:
  enabled: false
  project_path: ~/.config/auto-video/remotion

youtube:
  enabled: false
  client_secret: ~/.config/auto-video/youtube_client_secret.json
  credentials_file: ~/.config/auto-video/youtube_credentials.json
  redirect_host: "127.0.0.1"
  redirect_port: 7777
  default_privacy: private
  default_tags: []
  default_category_id: "22"
  default_license: creativeCommon
  notify_subscribers: true
  made_for_kids: false

paths:
  helpers: ~/.config/auto-video/helpers
  cache: ~/.config/auto-video/cache
  output: ~/Videos/auto-video

video:
  default_format: short  # short | long
  default_language: fr
  gpu_acceleration: auto  # auto | nvenc | amf | qsv | cpu | none
